# ==========================================
# 环境变量配置模板 (.env)
# 严格按照网络安全实习选题6要求：API Key 通过环境变量管理
# ==========================================

# 1. 运行模式: 'api' 表示连接 LongCat-2.5 真实大模型, 'mock' 表示离线仿真评测
RUN_MODE=api

# 2. 美团 LongCat API 开放平台配置 (标准 OpenAI 兼容协议)
# 密钥获取地址: https://longcat.chat/platform (登录后在 API Keys 页面创建 ak_... 密钥)
# OpenAI 兼容端点: https://api.longcat.chat/openai/v1
LLM_API_KEY=your_longcat_api_key_here
LLM_BASE_URL=https://api.longcat.chat/openai/v1
LLM_MODEL=LongCat-2.5

# 可选: 若使用 OpenRouter Reasoning 模型可设为 'none'/'medium'/'high'；LongCat-2.5 留空即可
LLM_REASONING_EFFORT=

# 3. 基础问答服务设定
SERVICE_HOST=127.0.0.1
SERVICE_PORT=8000
